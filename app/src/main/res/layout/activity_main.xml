<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C10"
    android:keepScreenOn="true">

    <!-- 1. VISOR DE CAMARA SIN RECORTE -->
    <TextureView
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 2. CAPA DE GRID DE TERCIOS, FOCUS PEAKING Y NIVEL -->
    <com.cinepro.camera.ui.CineOverlaysView
        android:id="@+id/cineOverlays"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="120dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/btnCodecMode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="OPEN GATE 4:3"
            android:textColor="#38E8FF"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnFps"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="24 fps"
            android:textColor="#E0E6ED"
            android:textSize="11sp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtTimecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="3dp"
                android:text="00:00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLutToggle"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="LUT REC709: OFF"
                android:textColor="#B0BEC5"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/txtStorage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="RAW DNG + HEVC"
            android:textColor="#B0BEC5"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtBattery"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="100%"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. BARRA IZQUIERDA (PEAKING CONFIGURABLE, GRID DE TERCIOS, NIVEL, HISTOGRAMA) -->
    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="56dp"
        android:paddingBottom="10dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btnPeaking"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="PEAK"
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGrid"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="GRID"
                android:textColor="#38E8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLevel"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="LVL"
                android:textColor="#38E8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <ProgressBar
                    android:id="@+id/vuLeft"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progress="65"
                    android:rotation="270" />

                <ProgressBar
                    android:id="@+id/vuRight"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:max="100"
                    android:progress="60"
                    android:rotation="270" />
            </LinearLayout>
        </LinearLayout>

        <com.cinepro.camera.ui.RgbHistogramView
            android:id="@+id/rgbHistogram"
            android:layout_width="78dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_card" />
    </LinearLayout>

    <!-- 5. PANEL EMERGENTE CON LA RUEDA (SOLO ASOMA CUANDO TOCAS UN BOTON) -->
    <LinearLayout
        android:id="@+id/popupParameterMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="104dp"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPopupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AJUSTE MANUAL"
                android:textColor="#38E8FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClosePopup"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="OCULTAR RUEDA ▼"
                android:textColor="#FF5252"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rueda interactiva + Botones rapidos lado a lado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- La Rueda que asoma solo al abrir esta opcion -->
            <com.cinepro.camera.ui.ArcDialView
                android:id="@+id/popupArcDial"
                android:layout_width="145dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/presetButtonsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <SeekBar
                    android:id="@+id/popupSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="50" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 6. PANEL INFERIOR COMPACTO (SOLO TEXTO, SIN RUEDAS FIJAS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="104dp"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- CARD 1: [FOCUS] -->
        <LinearLayout
            android:id="@+id/cardFocus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[FOCUS]"
                android:textColor="#9BAAB8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/valFocus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AF-C"
                android:textColor="#38E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 2: [ISO] -->
        <LinearLayout
            android:id="@+id/cardIso"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ISO]"
                android:textColor="#9BAAB8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/valIso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="400"
                android:textColor="#38E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 3: [SHUTTER] -->
        <LinearLayout
            android:id="@+id/cardShutter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[SHUTTER]"
                android:textColor="#9BAAB8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/valShutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/48s"
                android:textColor="#38E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 4: [WB] -->
        <LinearLayout
            android:id="@+id/cardWb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[WB]"
                android:textColor="#9BAAB8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/valWb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5600K"
                android:textColor="#38E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_wb_gradient" />
        </LinearLayout>

        <!-- CARD 5: [IRIS] -->
        <LinearLayout
            android:id="@+id/cardIris"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[IRIS]"
                android:textColor="#9BAAB8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/valIris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 EV"
                android:textColor="#38E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 7. BARRA LATERAL DERECHA: LENTE + FOTO RAW + REC + GALERIA + LOG -->
    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.cinepro.camera.ui.CurvedZoomView
            android:id="@+id/curvedZoom"
            android:layout_width="34dp"
            android:layout_height="200dp" />

        <LinearLayout
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="#CC12161A"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/btnLensSwitch"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="#38E8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- NUEVO BOTON DE FOTOGRAFIA EN RAW (.DNG) MAXIMA RESOLUCION -->
            <TextView
                android:id="@+id/btnCaptureRaw"
                android:layout_width="58dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center"
                android:text="📷 RAW"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- BOTON REC VIDEO -->
            <TextView
                android:id="@+id/btnRecord"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_rec_button"
                android:gravity="center"
                android:text="REC"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/btnOpenGallery"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:text="▶ GAL"
                android:textColor="#E0E6ED"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLogProfile"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:text="LOG"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
